# ---------------------------------------------------------------------------------------------
#  Copia este archivo como .env (cp .env.example .env) y completa tus valores.
#  .env está en .gitignore: tus credenciales nunca se versionan.
#  Las variables de entorno reales tienen prioridad sobre este archivo (así funciona CI).
# ---------------------------------------------------------------------------------------------

# Ambiente por defecto cuando no pasas -Penv=...  (local | ci | browserstack | saucelabs)
TEST_ENV=local

# Nombre del build en los dashboards de la nube
BUILD_NAME=local

# BrowserStack App Automate (https://www.browserstack.com/accounts/settings)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# Sauce Labs (User settings > Access Key). Región: us-west-1 | eu-central-1
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
SAUCE_REGION=us-west-1
