# ---------------------------------------------------------------------------------------------
#  Copy this file to .env (cp .env.example .env) and fill in your values.
#  .env is in .gitignore: your credentials are never committed.
#  Real environment variables take precedence over this file (that is how CI works).
# ---------------------------------------------------------------------------------------------

# Default environment when -Penv=... is not given  (local | ci | browserstack | saucelabs)
TEST_ENV=local

# Build name on the cloud dashboards
BUILD_NAME=local

# BrowserStack App Automate (https://www.browserstack.com/accounts/settings)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# Sauce Labs (User settings > Access Key). Region: us-west-1 | eu-central-1
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
SAUCE_REGION=us-west-1

# SonarQube Cloud token (My Account > Security), used by scripts/sonar-report.sh
SONAR_TOKEN=
