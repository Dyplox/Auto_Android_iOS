# =============================================================================
#  .gitignore - Appium mobile automation (Gradle + Node toolchain)
# =============================================================================

# --- Secrets and local configuration (NEVER commit) ---------------------------
.env
.env.*
!.env.example
*.keystore
*.jks
*.p12
*.mobileprovision
# (anchored to the root: src/test/resources/config/env/local.properties IS committed)
/local.properties
/secrets.properties

# --- Gradle ------------------------------------------------------------------
.gradle/
build/
.kotlin/
# The wrapper jar IS committed (even if a global .gitignore excludes *.jar)
!gradle/wrapper/gradle-wrapper.jar

# --- Node toolchain (Appium, drivers, Allure CLI) ------------------------------
node_modules/
npm-debug.log*

# --- Run results and evidence ---------------------------------------------------
allure-results/
allure-report/
.allure/
screenshots/
*.log

# --- App under test binaries (downloaded with scripts/download-apps.sh) ---------
apps/*
!apps/.gitkeep
*.apk
*.aab
*.ipa

# --- IDEs ----------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/
.settings/
.project
.classpath
bin/

# --- Claude desktop app files --------------------------------------------------
Claude outputs/

# --- Operating system -----------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
